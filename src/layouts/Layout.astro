---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'LibraryTracker', description = 'Gestiona tu biblioteca de videojuegos' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <!-- Header / Navbar -->
    <header class="glass" style="position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--color-border);">
      <nav style="max-width: 1400px; margin: 0 auto; padding: 0.75rem 1.5rem; display: flex; align-items: center; justify-content: space-between;">
        <!-- Logo -->
        <a href="/" style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none; color: var(--color-text-primary);">
          <span style="font-size: 1.5rem;">🎮</span>
          <span style="font-size: 1.25rem; font-weight: 800; background: linear-gradient(135deg, var(--color-accent-primary), var(--color-accent-cyan)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
            LibraryTracker
          </span>
        </a>

        <!-- Nav links -->
        <div style="display: flex; align-items: center; gap: 1rem;">
          <a href="/" class="nav-link" style="color: var(--color-text-secondary); text-decoration: none; font-size: 0.875rem; font-weight: 500; transition: color 0.2s ease;">
            Biblioteca
          </a>
          <a href="/stats" class="nav-link" style="color: var(--color-text-secondary); text-decoration: none; font-size: 0.875rem; font-weight: 500; transition: color 0.2s ease;">
            Estadísticas
          </a>
        </div>
      </nav>
    </header>

    <!-- Main Content -->
    <main style="max-width: 1400px; margin: 0 auto; padding: 2rem 1.5rem;">
      <slot />
    </main>

    <!-- Footer -->
    <footer style="border-top: 1px solid var(--color-border); padding: 1.5rem; text-align: center; color: var(--color-text-muted); font-size: 0.75rem;">
      LibraryTracker &copy; {new Date().getFullYear()} — Powered by IGDB
    </footer>

    <style>
      .nav-link:hover {
        color: var(--color-accent-primary) !important;
      }
    </style>
  </body>
</html>
